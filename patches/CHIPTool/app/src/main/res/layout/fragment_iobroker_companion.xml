<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Header / Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#1E1E2C"
            app:title="ioBroker Matter Companion"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Tab Layout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E2C"
        app:tabTextColor="#A0A0A0"
        app:tabSelectedTextColor="#4CAF50"
        app:tabIndicatorColor="#4CAF50"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stick &amp; Anlernen" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meine Geräte" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Frame für Tab 1: Koppelung & Setup -->
    <ScrollView
        android:id="@+id/tabPairingLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card: SMLIGHT IP Setup -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#2E2E3E"
                app:cardBackgroundColor="#1E1E2C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SMLIGHT Stick Verbindung"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ipInputLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_marginEnd="8dp"
                            android:hint="SMLIGHT Stick IP-Adresse"
                            app:boxStrokeColor="#4CAF50">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stickIpEd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:textColor="#FFFFFF"
                                android:text="192.168.179.148"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/stickPortLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Port"
                            app:boxStrokeColor="#4CAF50">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stickPortEd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="#FFFFFF"
                                android:text="8080"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fetchCredentialsBtn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Thread-Daten abrufen"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#4CAF50"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: ioBroker REST-API Setup -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#2E2E3E"
                app:cardBackgroundColor="#1E1E2C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ioBroker Verbindung"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/iobrokerIpLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_marginEnd="8dp"
                            android:hint="ioBroker IP"
                            app:boxStrokeColor="#2196F3">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/iobrokerIpEd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:textColor="#FFFFFF"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/iobrokerPortLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Port"
                            app:boxStrokeColor="#2196F3">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/iobrokerPortEd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="#FFFFFF"
                                android:text="8087"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testIobrokerBtn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Verbindung testen"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#2196F3"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Aktives Thread-Netzwerk -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/threadInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#2E2E3E"
                app:cardBackgroundColor="#1E1E2C">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aktive Thread-Daten"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/threadNameTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Name: -"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/threadChannelTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kanal: -"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/threadKeyTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Key: -"
                        android:textColor="#B0B0B0"
                        android:textSize="12sp"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Großer Button zum Anlernen -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/startCommissioningBtn"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="Neues Gerät anlernen"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@android:drawable/ic_menu_camera"
                app:cornerRadius="12dp"
                app:backgroundTint="#2196F3"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Frame für Tab 2: Geräte-Liste -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabDevicesLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabLayout"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
