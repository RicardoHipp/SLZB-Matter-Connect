<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/companionRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_bg">

    <!-- Header / Custom Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/theme_bg"
            app:contentInsetStart="16dp"
            app:contentInsetEnd="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Title & Connection Status -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ioBroker Matter"
                        android:textColor="@color/theme_on"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Status layout with green dot and text -->
                    <LinearLayout
                        android:id="@+id/connectionStatusLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/connectionStatusDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/circle_dot_gray" />

                        <TextView
                            android:id="@+id/connectionStatusTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verbinde..."
                            android:textColor="@color/theme_onv"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Actions (Theme Toggle & Settings) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <!-- Hilfe / Ablauf Button -->
                    <ImageButton
                        android:id="@+id/helpButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Hilfe / Ablauf"
                        android:src="@drawable/ic_help"
                        app:tint="@color/theme_onv" />

                    <!-- Theme Toggle Button -->
                    <ImageButton
                        android:id="@+id/themeToggleButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Design umschalten"
                        android:src="@drawable/ic_theme_toggle"
                        app:tint="@color/theme_onv" />

                    <!-- Settings Button -->
                    <ImageButton
                        android:id="@+id/settingsButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Einstellungen"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/theme_onv" />
                </LinearLayout>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Divider under AppBar -->
    <View
        android:id="@+id/appBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/theme_outline"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout" />

    <!-- Tabs: Meine Geraete / ioBroker -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/deviceTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/theme_bg"
        app:tabTextColor="@color/theme_onv"
        app:tabSelectedTextColor="@color/theme_accent"
        app:tabIndicatorColor="@color/theme_accent"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:layout_constraintTop_toBottomOf="@id/appBarDivider" />

    <!-- Unified Devices & Commissioning Layout -->
    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/deviceTabLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Commissioning Button directly above list -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startCommissioningBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Neues Gerät anlernen"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#04110e"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="16dp"
            app:iconTint="#04110e"
            app:cornerRadius="100dp"
            app:backgroundTint="@color/theme_accent" />

        <!-- RecyclerView for device items list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabDevicesLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            tools:listitem="@layout/device_item"/>
    </LinearLayout>
    <!-- ioBroker-Geraete (zweiter Tab) -->
    <LinearLayout
        android:id="@+id/iobrokerLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/deviceTabLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/iobrokerPlaceholderTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:gravity="center"
            android:text="ioBroker-Geraete erscheinen hier.\n(Datenanbindung folgt als Naechstes.)"
            android:textColor="@color/theme_onv"
            android:textSize="13sp" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/iobrokerSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/iobrokerDevicesRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:clipToPadding="false" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
