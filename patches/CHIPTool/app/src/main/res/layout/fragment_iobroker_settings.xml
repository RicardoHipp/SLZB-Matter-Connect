<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Header / Pagebar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/settingsAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/settingsToolbar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@color/theme_bg"
            app:contentInsetStart="12dp"
            app:contentInsetEnd="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Back arrow -->
                <ImageButton
                    android:id="@+id/settingsBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Zurück"
                    android:src="@drawable/ic_back"
                    app:tint="@color/theme_on" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@id/settingsBackButton"
                    android:layout_marginStart="8dp"
                    android:text="Verbindungseinstellungen"
                    android:textColor="@color/theme_on"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/settingsDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/theme_outline"
        app:layout_constraintTop_toBottomOf="@id/settingsAppBar" />

    <!-- Scrollable Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/settingsDivider"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section: SMLIGHT Stick -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CustomCardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SMLIGHT Stick"
                        android:textColor="@color/theme_on"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp"/>

                    <!-- IP and Port in horizontal row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/stickIpLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_marginEnd="8dp"
                            android:hint="IP-Adresse"
                            app:boxBackgroundColor="@color/theme_field"
                            app:boxStrokeColor="@color/theme_accent"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:hintTextColor="@color/theme_accent"
                            android:textColorHint="@color/theme_onv">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stickIpEd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:textColor="@color/theme_on"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/stickPortLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Port"
                            app:boxBackgroundColor="@color/theme_field"
                            app:boxStrokeColor="@color/theme_accent"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:hintTextColor="@color/theme_accent"
                            android:textColorHint="@color/theme_onv">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/stickPortEd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/theme_on"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/fetchCredentialsBtn"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Thread-Daten abrufen"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#04110e"
                        app:backgroundTint="@color/theme_accent"
                        app:cornerRadius="100dp"/>

                    <!-- Thread credentials details directly inside settings card -->
                    <LinearLayout
                        android:id="@+id/settingsThreadInfoLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/theme_outline"
                            android:layout_marginBottom="14dp"/>

                        <TextView
                            android:id="@+id/settingsThreadNameTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Netzwerkname · -"
                            android:textColor="@color/theme_onv"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/settingsThreadChannelTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Kanal · -  ·  PAN ID -"
                            android:textColor="@color/theme_onv"
                            android:textSize="12sp"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NETWORK KEY"
                            android:textColor="@color/theme_onv"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/settingsThreadKeyTv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:fontFamily="monospace"
                            android:textColor="@color/theme_on"
                            android:textSize="10.5sp"
                            android:background="@drawable/mono_field_bg"
                            android:padding="8dp"
                            android:textIsSelectable="true"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section: ioBroker -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CustomCardViewStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ioBroker"
                        android:textColor="@color/theme_on"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="IP vom ioBroker-Server · Port vom Adapter „Einfache RESTful API“ (simple-api, Standard 8087) – nicht der ioBroker-Port selbst"
                        android:textColor="@color/theme_onv"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.1"
                        android:layout_marginBottom="14dp"/>

                    <!-- IP and Port in horizontal row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/iobrokerIpLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:layout_marginEnd="8dp"
                            android:hint="IP-Adresse"
                            app:boxBackgroundColor="@color/theme_field"
                            app:boxStrokeColor="@color/theme_accent"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:hintTextColor="@color/theme_accent"
                            android:textColorHint="@color/theme_onv">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/iobrokerIpEd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="phone"
                                android:textColor="@color/theme_on"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/iobrokerPortLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="API-Port"
                            app:boxBackgroundColor="@color/theme_field"
                            app:boxStrokeColor="@color/theme_accent"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:hintTextColor="@color/theme_accent"
                            android:textColorHint="@color/theme_onv">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/iobrokerPortEd"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/theme_on"
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/testIobrokerBtn"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Verbindung testen"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/theme_accent"
                        app:backgroundTint="@color/theme_surface2"
                        app:cornerRadius="100dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Spacer to push done button to bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsDoneButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Fertig"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#04110e"
                app:backgroundTint="@color/theme_accent"
                app:cornerRadius="100dp"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
